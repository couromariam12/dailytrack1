# Public application URL.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Gitea configuration. These values are read only by server-side code.
GITEA_URL=https://gitea.dev.agilicis.com
GITEA_TOKEN=
GITEA_TIMEOUT_SECONDS=10
GITEA_TOKEN=

# Development only. Never enable this in production.
DAILYTRACK_DEV_AUTH=false
DAILYTRACK_DEV_ROLE=collaborator

# Gitea OAuth2 / PKCE. For a public PKCE client, the secret may remain empty.
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
GITEA_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/gitea/callback
GITEA_OAUTH_SCOPES=read:user,read:repository

# Session secret for the future authentication layer.
AUTH_SECRET=
DAILYTRACK_ADMIN_LOGINS=
