# Public application URL.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001

# Gitea configuration. These values are read only by server-side code.
GITEA_URL=https://gitea.dev.agilicis.com
GITEA_TIMEOUT_SECONDS=10
# Service token: used only by the local MCP server and by the development auth mode below.
GITEA_TOKEN=

# Development only. Never enable this in production (it is refused when NODE_ENV=production).
DAILYTRACK_DEV_AUTH=false
DAILYTRACK_DEV_ROLE=collaborator

# Gitea OAuth2 / PKCE. For a public PKCE client, the secret may remain empty.
GITEA_OAUTH_CLIENT_ID=
GITEA_OAUTH_CLIENT_SECRET=
GITEA_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/api/auth/gitea/callback
GITEA_OAUTH_SCOPES=read:user,read:repository,read:issue

# Encrypts the session cookie. At least 32 characters, e.g. `openssl rand -base64 32`.
# Changing it signs every user out.
AUTH_SECRET=
# Comma-separated Gitea logins allowed to open /admin.
DAILYTRACK_ADMIN_LOGINS=
